FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (water air);

water
{
    transportModel  Newtonian;
    nu              1e-2;
    rho             1000;
}

air
{
    transportModel  Newtonian;
    nu              1e-1;
    rho             1;
}

sigma           1.96;

// Level-set coupling. Every entry is optional; the values below are the
// defaults, except cellSize, which defaults to the smallest cell spacing.
levelSet
{
    cellSize         0.00625;   // reference cell size h [m]
    widthCoeff       1.5;       // interface half-width / h
    seedCoeff        0.75;      // |initial distance| / h
    pseudoTimeCoeff  0.1;       // redistance pseudo-time step / h
    curvatureFrom    levelSet;  // levelSet | volumeFraction
    propertiesFrom   levelSet;  // levelSet | volumeFraction
}


