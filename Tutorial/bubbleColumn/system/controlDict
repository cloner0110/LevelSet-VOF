FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     interLevelSetFoam;

startFrom       startTime; 

startTime       0;

stopAt          endTime;

endTime         3;

deltaT          0.000390625; // dT= h/16 

writeControl    adjustableRunTime;

writeInterval   0.2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression uncompressed;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           1;
maxAlphaCo      1;

maxDeltaT       1e-3;

// Benchmark quantities of Hysing et al. (2009), test case 2: centre of mass
// and mean rise velocity of the bubble (phase "air"), written every step to
// postProcessing/bubble/0/volFieldValue.dat
functions
{
    bubbleY
    {
        type            exprField;
        libs            (fieldFunctionObjects);
        field           bubbleY;
        useNamePrefix   false;
        expression      "pos().y()";
        dimensions      [0 1 0 0 0 0 0];
        executeControl  timeStep;
        writeControl    none;
    }

    bubble
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        fields          (bubbleY U);
        operation       weightedVolAverage;
        weightField     alpha.air;
        regionType      all;
        writeFields     false;
        log             false;
        executeControl  timeStep;
        writeControl    timeStep;
    }
}


