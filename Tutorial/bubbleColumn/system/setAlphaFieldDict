FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setAlphaFieldDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Circular bubble of radius 0.25 centred at (0.5, 0.5), Hysing et al. (2009).
// setAlphaField integrates the volume fraction exactly in each cut cell, so
// the initial bubble area is pi*0.25^2 instead of a stair-cased cell set.

field       alpha.water;
type        cylinder;
origin      (0.5 0.5 0);
direction   (0 0 1);
radius      0.25;
invert      true;   // alpha.water = 0 inside the bubble, 1 outside


// ************************************************************************* //
